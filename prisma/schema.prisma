generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model prioridades {
  id        Int       @id @default(autoincrement())
  descricao String
  ativo     Boolean   @default(true)
  tarefas   tarefas[]
}

model projetos {
  id         Int       @id @default(autoincrement())
  nome       String
  descricao  String?
  usuario_id Int
  criado_em  DateTime? @default(now()) @db.Timestamp(6)
  usuarios   usuarios  @relation(fields: [usuario_id], references: [id])
  tarefas    tarefas[]
}

model usuarios {
  id        Int       @id @default(autoincrement())
  nome      String
  email     String    @unique
  senha     String
  criado_em DateTime? @default(now()) @db.Timestamp(6)
  projetos  projetos[]
  tarefas   tarefas[]
}

model tarefas {
  id           Int         @id @default(autoincrement())
  texto        String
  coluna       String      @db.VarChar(20)
  ordem        Int?        @default(0)
  projeto_id   Int
  usuario_id   Int
  criado_em    DateTime?   @default(now()) @db.Timestamp(6)
  iniciada_em  DateTime?   @db.Timestamp(6)
  concluida_em DateTime?   @db.Timestamp(6)
  idprioridade Int
  prioridades  prioridades @relation(fields: [idprioridade], references: [id])
  projetos     projetos    @relation(fields: [projeto_id], references: [id])
  usuarios     usuarios    @relation(fields: [usuario_id], references: [id])
}